{
  "name": "agent-lab-desktop",
  "version": "0.3.1",
  "private": true,
  "type": "module",
  "description": "An Electron workbench for learning and experimenting with the Claude Agent SDK.",
  "author": "fang-l",
  "main": "dist-electron/index.js",
  "scripts": {
    "dev": "vite --configLoader runner",
    "build": "tsc --noEmit && vite build --configLoader runner && electron-builder --dir",
    "build:web": "tsc --noEmit && vite build --configLoader runner",
    "preview": "vite preview --configLoader runner",
    "test": "tsx --test src/**/*.test.ts electron/**/*.test.ts",
    "test:watch": "tsx --test --watch src/**/*.test.ts electron/**/*.test.ts",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.216",
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "marked": "^15.0.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.3",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^43.1.1",
    "electron-builder": "^26.15.3",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.14.0",
    "prettier": "^3.4.2",
    "tsx": "^4.20.5",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.19.1",
    "vite": "^6.0.7",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6"
  },
  "build": {
    "appId": "dev.agentlab.desktop",
    "productName": "AgentLab",
    "directories": {
      "output": "release-candidate"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/@anthropic-ai/claude-agent-sdk-darwin-arm64/**/*",
      "node_modules/@anthropic-ai/claude-agent-sdk-darwin-x64/**/*",
      "node_modules/@anthropic-ai/claude-agent-sdk-linux-arm64/**/*",
      "node_modules/@anthropic-ai/claude-agent-sdk-linux-x64/**/*",
      "node_modules/@anthropic-ai/claude-agent-sdk-win32-arm64/**/*",
      "node_modules/@anthropic-ai/claude-agent-sdk-win32-x64/**/*"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ]
    }
  }
}
